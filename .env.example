# Server-side only. Never expose these to the web/mobile clients.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
RAW_DATABASE_URL=            # default: SQLite file in services/api/data. e.g. postgresql+psycopg://user:pw@host/db
RAW_DATA_DIR=                # uploads + sqlite location
RAW_MAX_UPLOAD_BYTES=5242880
RAW_RATE_LIMIT_PER_MIN=240
RAW_WORKER_THREADS=2
RAW_PRICING_JSON=            # {"openai:model-id": {"in": 0, "out": 0, "cached_in": 0}}  (USD per 1M tokens; you supply real prices)
NEXT_PUBLIC_API_URL=http://localhost:8000
